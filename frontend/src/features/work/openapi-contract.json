          "version",
          "content_hash",
          "items",
          "reporting_timezone"
        ],
        "properties": {
          "id": "string:uuid",
          "version": "integer",
          "content_hash": "string",
          "items": "array:ref:DailyUpdateItemInput-Output",
          "assessment_state": "literal:UNAVAILABLE",
          "reporting_timezone": "string",
          "confirmed_update_id": "null|string:uuid"
        }
      },
      "DailyUpdateDraftRequest": {
        "required": [
          "items"
        ],
        "properties": {
          "items": "array:ref:DailyUpdateItemInput-Input"
        }
