          "expected_progress_version",
          "reported_percent",
          "reporting_date",
          "done_text"
        ],
        "properties": {
          "task_id": "string:uuid",
          "expected_task_version": "integer",
          "expected_progress_version": "integer",
          "reported_percent": "number|string",
          "remaining_hours": "null|number|string",
          "spent_hours": "null|number|string",
          "reporting_date": "string:date",
          "done_text": "string[1,4000]",
          "next_steps": "string[,4000]",
          "evidence_refs": "array:ref:SelectedEvidence",
          "corrects_observation_id": "null|string:uuid",
          "correction_reason": "string[,1000]"
        }
      },
      "DailyUpdateItemInput-Output": {
        "required": [
          "task_id",
          "expected_task_version",
          "expected_progress_version",
          "reported_percent",
          "reporting_date",
          "done_text"
        ],
        "properties": {
          "task_id": "string:uuid",
          "expected_task_version": "integer",
          "expected_progress_version": "integer",
          "reported_percent": "string",
          "remaining_hours": "null|string",
          "spent_hours": "null|string",
          "reporting_date": "string:date",
          "done_text": "string[1,4000]",
          "next_steps": "string[,4000]",
          "evidence_refs": "array:ref:SelectedEvidence",
          "corrects_observation_id": "null|string:uuid",
          "correction_reason": "string[,1000]"
        }
      },
      "DailyUpdateRevisionRequest": {
        "required": [
          "items",
          "expected_version"
        ],
        "properties": {
          "items": "array:ref:DailyUpdateItemInput-Input",
          "expected_version": "integer"
        }
      },
      "SelectedEvidence": {
        "required": [
          "evidence_id",
          "version"
        ],
        "properties": {
          "evidence_id": "string:uuid",
          "version": "integer"
        }
      },
      "TaskReportingContext": {
        "required": [
          "task_id",
          "task_version",
          "progress_version",
          "reported_percent",
          "remaining_hours",
          "reporting_timezone",
          "reporting_date",
          "project_week_state"
        ],
        "properties": {
          "task_id": "string:uuid",
          "task_version": "integer",
          "progress_version": "integer",
          "reported_percent": "null|string",
          "remaining_hours": "null|string",
          "reporting_timezone": "string",
          "reporting_date": "string:date",
          "project_week_state": "literal:LINKED|NO_PROJECT_WEEK",
          "evidence_refs": "array:ref:SelectedEvidence"
        }
      }
    }
  }
}
