          "captured_at",
          "kind",
          "start_date",
          "end_date",
          "week_version",
          "sealed_at"
        ],
        "properties": {
          "id": "string:uuid",
          "project_week_id": "string:uuid",
          "task_entries": "array:ref:PlanEntry",
          "captured_at": "string:date-time",
          "kind": "string",
          "start_date": "string:date",
          "end_date": "string:date",
