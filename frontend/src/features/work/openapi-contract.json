          "known_effort_fraction": "null|string",
          "known_effort_hours": "string",
          "total_effort_hours": "string",
          "task_coverage_fraction": "null|string",
          "unknown_progress_ids": "array:string:uuid",
          "missing_estimate_ids": "array:string:uuid",
          "stale_task_ids": "array:string:uuid",
          "remaining_hours": "null|string",
          "unknown_remaining_ids": "array:string:uuid",
          "task_actuals": "array:ref:TaskActual"
        }
      },
      "PlanBaseline": {
        "required": [
          "id",
