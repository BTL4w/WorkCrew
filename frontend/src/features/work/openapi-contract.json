  "daily_updates": {
    "paths": {
      "/api/v1/daily-updates/drafts": [
        "post"
      ],
      "/api/v1/daily-updates/drafts/{draft_id}": [
        "get"
      ],
      "/api/v1/daily-updates/{draft_id}/draft": [
        "patch"
      ],
      "/api/v1/daily-updates/{draft_id}/confirm": [
        "post"
      ],
      "/api/v1/daily-updates": [
        "post",
        "get"
      ],
      "/api/v1/tasks/{task_id}/reporting-context": [
        "get"
      ]
    },
    "schemas": {
      "ConfirmDailyUpdateCommand": {
        "required": [
          "draft_id",
          "expected_draft_version"
        ],
        "properties": {
          "draft_id": "string:uuid",
          "expected_draft_version": "integer",
          "assessment_id": "null|string:uuid",
          "warning_acknowledgments": "array:string:uuid"
        }
      },
      "ConfirmedDailyUpdate": {
        "required": [
          "id",
          "draft_id",
          "observations"
        ],
        "properties": {
          "id": "string:uuid",
          "draft_id": "string:uuid",
          "observations": "array:ref:ConfirmedObservation",
          "assessment_state": "literal:UNAVAILABLE"
        }
      },
      "ConfirmedObservation": {
        "required": [
          "id",
          "update_id",
          "item",
          "progress_version",
          "reporting_at",
          "confirmed_at",
          "reporting_timezone",
          "late",
          "project_week_state"
        ],
        "properties": {
