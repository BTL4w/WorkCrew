      "RecommendationFeedbackResponse": { "required": ["id", "recommendation_id", "version", "kind", "comment"], "properties": { "id": "string:uuid", "recommendation_id": "string:uuid", "version": "integer", "kind": "literal:accept|override|reject", "comment": "string" } },
      "ProjectTeamMembershipResponse": { "required": ["id", "project_id", "membership_id", "decision_id", "active", "created_at"], "properties": { "id": "string:uuid", "project_id": "string:uuid", "membership_id": "string:uuid", "decision_id": "string:uuid", "active": "boolean", "created_at": "string:date-time" } },
      "ProjectTeamResponse": { "required": ["memberships"], "properties": { "memberships": "array:ref:ProjectTeamMembershipResponse" } }
    }
  },
  "explicit_assignment": {
