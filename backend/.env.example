APP_ENVIRONMENT=local
APP_DEBUG=false
APP_DATABASE_URL=postgresql+psycopg://work_management:work_management@localhost:5432/work_management
APP_LOCAL_AUTH_ORGANIZATION_SLUG=demo
APP_LOCAL_AUTH_ORGANIZATION_NAME=Demo Organization
APP_DEMO_SEED_ENABLED=true
APP_DEMO_SEED_PASSWORD=WorkDemo123!
APP_SESSION_COOKIE_NAME=work_management_session
APP_SESSION_TTL_SECONDS=28800
APP_SESSION_SECURE_COOKIE=false
APP_FRONTEND_ORIGIN=http://localhost:3000
APP_AI_PROVIDER=disabled
APP_AI_MODEL=
# Independent first-message naming model; uses the same provider and API key.
APP_AI_TITLE_MODEL=gpt-4o-mini
APP_AI_TITLE_TIMEOUT_SECONDS=3
APP_OPENAI_API_KEY=
APP_LANGSMITH_TRACING=false
APP_LANGSMITH_API_KEY=
APP_AI_RAW_CONTEXT_RETENTION_DAYS=30
APP_AI_REDACTED_TRACE_RETENTION_DAYS=90
APP_WORKER_ID=
# Worker is idle if list is empty. Add real tenant UUIDs to process their jobs.
APP_WORKER_ORGANIZATION_IDS='[]'
# Example: APP_WORKER_ORGANIZATION_IDS='["<real-organization-uuid>"]'
