# Local PostgreSQL container configuration only. Do not reuse in production.
POSTGRES_DB=work_management
POSTGRES_USER=work_management
POSTGRES_PASSWORD=work_management
POSTGRES_PORT=5432
APP_AI_PROVIDER=disabled
APP_AI_MODEL=
APP_OPENAI_API_KEY=
APP_LANGSMITH_TRACING=false
APP_LANGSMITH_API_KEY=
APP_AI_RAW_CONTEXT_RETENTION_DAYS=30
APP_AI_REDACTED_TRACE_RETENTION_DAYS=90
APP_WORKER_ID=
# Worker is idle if list is empty. Add real tenant UUIDs to process their jobs.
APP_WORKER_ORGANIZATION_IDS='[]'
# Example: APP_WORKER_ORGANIZATION_IDS='["<real-organization-uuid>"]'

# IANA timezone for daily reporting dates (server default: UTC).
APP_REPORTING_TIMEZONE=Asia/Ho_Chi_Minh
