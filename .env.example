# Local PostgreSQL container configuration only. Do not reuse in production.
POSTGRES_DB=work_management
POSTGRES_USER=work_management
POSTGRES_PASSWORD=work_management
POSTGRES_PORT=5432
APP_AI_PROVIDER=disabled
APP_AI_MODEL=
APP_OPENAI_API_KEY=
# I3 stays off until runtime, durable budgets and rollout gates are implemented.
APP_RETRIEVAL_ENABLED=false
APP_RETRIEVAL_PROVIDER=disabled
APP_RETRIEVAL_CORE_EXIT_VERIFIED=false
APP_EXA_API_KEY=
APP_LANGSMITH_TRACING=false
APP_LANGSMITH_API_KEY=
# APP_LANGSMITH_TRACING enables the safe exporter; SDK auto tracing stays disabled.
# Agent addressing requires langsmith>=0.14.4; do not also set LANGSMITH_PROJECT.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=workcrew
LANGSMITH_AGENT_ENVIRONMENT=local
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# false shows allowlisted structured operational I/O, never raw prompts/state.
APP_LANGSMITH_ENDPOINT=
# LANGSMITH_* key/agent/environment/endpoint aliases are accepted by Settings.
APP_AI_RAW_CONTEXT_RETENTION_DAYS=30
APP_AI_REDACTED_TRACE_RETENTION_DAYS=90
APP_WORKER_ID=
# Worker is idle if list is empty. Add real tenant UUIDs to process their jobs.
APP_WORKER_ORGANIZATION_IDS='[]'
# Example: APP_WORKER_ORGANIZATION_IDS='["<real-organization-uuid>"]'

# IANA timezone for daily reporting dates (server default: UTC).
APP_REPORTING_TIMEZONE=Asia/Ho_Chi_Minh
